{
  "appId": "com.jaquealrey.admin",
  "productName": "Hotel Jaque al Rey",
  "directories": {
    "output": "dist"
  },
  "win": {
    "target": [
      "nsis",
      "dir"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "files": [
    "dist/**/*",
    "main.js",
    "package.json"
  ]
}
